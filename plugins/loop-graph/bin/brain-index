#!/usr/bin/env bash
# Rebuild a code knowledge graph of the current repository with Graphify
# (PyPI package `graphifyy`, Apache-2.0, https://github.com/Graphify-Labs/graphify).
# Code is parsed locally by tree-sitter: no model call. The only network use is installing the pinned
# package from PyPI into a throw-away virtual environment. Indexes exactly what is committed
# (`git archive HEAD`), so unfinished work in the tree never leaks into the map.
#
# Usage: brain-index            (run inside the repository; nothing is committed)
# Environment:
#   BRAIN_INDEX_OUT      output directory, relative to the repo root   (default: docs/codebase-index)
#   BRAIN_INDEX_EXCLUDE  space-separated repo-relative paths to leave out, e.g. generated data
#                        (default: none; the output directory is always left out)
#   BRAIN_INDEX_PYTHON   Python 3 interpreter used to create the venv  (default: python3)
#   CLAUDE_PROJECT_DIR   repository to index                           (default: current directory)
set -euo pipefail

GRAPHIFY_VERSION="0.9.100"

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
  exit 0
fi

die() { echo "brain-index: $*" >&2; exit 2; }

# A repo-relative path: not empty, not absolute, no '..' segment.
safe_rel() {
  local p="$1"
  [[ -n "$p" && "$p" != /* && "/$p/" != */../* ]]
}

out_rel="${BRAIN_INDEX_OUT:-docs/codebase-index}"
out_rel="${out_rel%/}"
safe_rel "$out_rel" || die "BRAIN_INDEX_OUT must be a path inside the repository (got '$out_rel')"
read -r -a excludes <<< "${BRAIN_INDEX_EXCLUDE:-}"
for p in "${excludes[@]}"; do
  safe_rel "$p" || die "BRAIN_INDEX_EXCLUDE entries must be paths inside the repository (got '$p')"
done
python="${BRAIN_INDEX_PYTHON:-python3}"

repo="$(git -C "${CLAUDE_PROJECT_DIR:-$PWD}" rev-parse --show-toplevel 2>/dev/null)" || die "not inside a git repository"
git -C "$repo" rev-parse --verify -q HEAD >/dev/null || die "the repository has no commit yet; commit first"
command -v "$python" >/dev/null || die "needs Python 3 ('$python' not found); set BRAIN_INDEX_PYTHON"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
"$python" -m venv "$work/venv"
"$work/venv/bin/python" -m pip install -q --disable-pip-version-check "graphifyy==${GRAPHIFY_VERSION}"

mkdir "$work/proj"
git -C "$repo" archive HEAD | tar -x -C "$work/proj"
rm -rf "${work:?}/proj/${out_rel}"
for p in "${excludes[@]}"; do rm -rf "${work:?}/proj/${p%/}"; done

export GRAPHIFY_BACKEND=none GRAPHIFY_QUERY_LOG_DISABLE=1
# No model keys reach the indexer, so the no-model guarantee does not depend on its defaults.
(cd "$work/proj" && env -u GEMINI_API_KEY -u GOOGLE_API_KEY -u OPENAI_API_KEY -u ANTHROPIC_API_KEY \
  "$work/venv/bin/graphify" update .)

[[ -f "$work/proj/graphify-out/graph.json" ]] || die "graphify produced no graph.json"
out="$repo/$out_rel"
mkdir -p "$out"
for f in graph.json graph.html GRAPH_REPORT.md; do
  if [[ -f "$work/proj/graphify-out/$f" ]]; then cp "$work/proj/graphify-out/$f" "$out/"; fi
done
commit="$(git -C "$repo" rev-parse --short HEAD)"
cat > "$out/README.md" <<EOF
# Codebase index (Graphify)

Generated by \`brain-index\`; do not edit by hand. A knowledge graph of the committed code at \`$commit\`, built by
[Graphify](https://github.com/Graphify-Labs/graphify) (\`graphifyy\` $GRAPHIFY_VERSION, Apache-2.0) with tree-sitter:
no model call. Excluded: \`$out_rel\`${BRAIN_INDEX_EXCLUDE:+ and \`$BRAIN_INDEX_EXCLUDE\`}.

It is a snapshot: if HEAD has moved past \`$commit\`, rebuild before relying on it.

| File | Use |
|---|---|
| \`GRAPH_REPORT.md\` | Start here: hubs, communities, surprising links |
| \`graph.html\` | Interactive graph; open it in a browser |
| \`graph.json\` | The full graph for queries |

Query it:
\`\`\`
python3 -m venv .venv && .venv/bin/pip install graphifyy==$GRAPHIFY_VERSION
.venv/bin/graphify explain "<symbol>" --graph $out_rel/graph.json
.venv/bin/graphify path "<from>" "<to>" --graph $out_rel/graph.json
\`\`\`
EOF
echo "Indexed $commit with graphifyy ${GRAPHIFY_VERSION} -> $out_rel/"
